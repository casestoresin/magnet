# Copy this file to .env.local and fill in your values

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/custom-magnets

# Cloudinary credentials (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: folder name inside Cloudinary
CLOUDINARY_FOLDER=custom-magnets

# Admin login (fixed credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
# Long random string used to sign the login cookie (e.g. openssl rand -hex 32)
AUTH_SECRET=change_me_to_a_long_random_string
